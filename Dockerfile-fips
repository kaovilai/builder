ARG UBI_MAJOR=9
FROM registry.access.redhat.com/ubi${UBI_MAJOR}:latest as base
# gcc: building the Go toolchain from source needs a C compiler.
# openssl-devel: required by the <=1.26 openssl-fips backend (CGO linking,
# and consumers compiling FIPS apps against libcrypto inside this image).
# The 1.27+ hostfips-release toolchain uses Go's native crypto/fips140
# module and does not link OpenSSL — but note RHEL's golang RPM (the
# bootstrap toolchain) itself requires openssl-devel, so a conditional
# install cannot remove it. Shipping it only for the openssl-fips backend
# needs a multi-stage build that keeps the dnf `go` bootstrap out of the
# final image.
RUN dnf -y install go git make jq unzip \
        gcc gcc-c++ openssl-devel perl && \
    dnf clean all

FROM base as builder
# FIPS_TAG: e.g. go1.24.2-1-openssl-fips (resolved by workflow, passed as build arg)
ARG FIPS_TAG=
RUN set -ex && \
    if [ -z "$FIPS_TAG" ]; then \
        echo "ERROR: FIPS_TAG build arg is required" && exit 1; \
    fi && \
    echo "FIPS_TAG=$FIPS_TAG" && \
    export GOROOT_BOOTSTRAP=$(go env GOROOT) && \
    git config --global user.name "builder" && \
    git config --global user.email "builder@konveyor.io" && \
    git clone --depth 1 --branch "$FIPS_TAG" \
        https://github.com/golang-fips/go.git /tmp/golang-fips && \
    cd /tmp/golang-fips && \
    ./scripts/full-initialize-repo.sh && \
    cd /tmp/golang-fips/go/src && \
    ./make.bash && \
    export GOPATH=$(go env GOPATH) && \
    rm -rf $GOPATH && \
    rm -f /usr/bin/go && \
    mkdir -p /opt/app-root/src/ && \
    mv /tmp/golang-fips/go /opt/app-root/src/go && \
    rm -rf /tmp/golang-fips && \
    export PATH=/opt/app-root/src/go/bin:$PATH && \
    go env && go version

ENV PATH=$PATH:/opt/app-root/src/go/bin
ENV APP_ROOT /opt/app-root
ENV GOPATH /opt/app-root/src/go
ENV GOEXPERIMENT=strictfipsruntime
